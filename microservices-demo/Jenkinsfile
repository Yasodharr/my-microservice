
pipeline {
    agent any

    triggers {
        pollSCM('H/2 * * * *')
    }

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    environment {
        AWS_REGION = 'us-east-1'
        ECR_REGISTRY = '319556313663.dkr.ecr.us-east-1.amazonaws.com'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Validate') {
            steps {
                dir('microservices-demo') {
                    sh 'docker compose config -q'

                    sh '''
                        python3 -m py_compile \
                        user-service/main.py \
                        product-service/main.py \
                        order-service/main.py \
                        payment-service/main.py
                    '''
                }
            }
        }

        stage('Build Images') {
            steps {
                dir('microservices-demo') {
                    sh '''
                        docker build -t user-service:v1 ./user-service
                        docker build -t product-service:v1 ./product-service
                        docker build -t order-service:v1 ./order-service
                        docker build -t payment-service:v1 ./payment-service
                    '''
                }
            }
        }

        stage('ECR Login') {
            steps {
                sh '''
                    aws ecr get-login-password --region $AWS_REGION |
                    docker login --username AWS --password-stdin $ECR_REGISTRY
                '''
            }
        }

        stage('Push Images') {
            steps {
                sh '''
                    docker tag user-service:v1 $ECR_REGISTRY/user-service:v1
                    docker tag product-service:v1 $ECR_REGISTRY/product-service:v1
                    docker tag order-service:v1 $ECR_REGISTRY/order-service:v1
                    docker tag payment-service:v1 $ECR_REGISTRY/payment-service:v1

                    docker push $ECR_REGISTRY/user-service:v1
                    docker push $ECR_REGISTRY/product-service:v1
                    docker push $ECR_REGISTRY/order-service:v1
                    docker push $ECR_REGISTRY/payment-service:v1
                '''
            }
        }

        stage('Deploy to EC2') {
            steps {
                dir('microservices-demo') {
                    sh '''
                        docker compose pull user-service product-service order-service

                        docker compose up -d --build --remove-orphans

                        docker compose ps
                    '''
                }
            }
        }
    }

    post {
        success {
            echo 'CI/CD Pipeline completed successfully!'
        }

        failure {
            echo 'Pipeline failed. Check the console output.'
        }
    }
}
